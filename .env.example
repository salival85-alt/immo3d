# Immo3D Environment Configuration

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL (Main Database)
DATABASE_URL=postgresql+psycopg://immo3d_user:immo3d_password@postgres:5432/immo3d_db
DATABASE_ECHO=False

# PostgreSQL (Vector Database)
VECTOR_DATABASE_URL=postgresql+psycopg://immo3d_user:immo3d_password@postgres-pgvector:5432/immo3d_vectors_db

# Redis
REDIS_URL=redis://immo3d_redis:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Monitoring
SENTRY_DSN=

# Database Migrations
ALEMBIC_SQLALCHEMY_URL=postgresql+psycopg://immo3d_user:immo3d_password@postgres:5432/immo3d_db
